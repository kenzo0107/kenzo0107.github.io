/* ---------------------------------
 *   Dark mode
 *   html[data-theme='dark'] が付いたときの配色上書き。
 *   ライトモード時は素の Bulma + default.styl の配色が使われる。
 * --------------------------------- */
$dark-bg = #14181d
$dark-surface = #1c2128
$dark-surface-2 = #22272e
$dark-border = #30363d
$dark-text = #c9d1d9
$dark-text-strong = #e6edf3
$dark-text-muted = #8b949e
$dark-link = #58a6ff

html[data-theme='dark']
    background-color: $dark-bg

    body
        background-color: $dark-bg
        color: $dark-text

    // 見出し・本文の文字色
    .title,
    .subtitle,
    h1, h2, h3, h4, h5, h6,
    strong,
    label
        color: $dark-text-strong

    .content
        color: $dark-text

    a
        color: $dark-link

    // --- Navbar ---
    .navbar-main
        background-color: $dark-surface

        .navbar-item,
        .navbar-link
            color: $dark-text

            &:hover,
            &.is-active
                background-color: $dark-surface-2
                color: $dark-text-strong

        .navbar-dropdown
            background-color: $dark-surface
            border-color: $dark-border
            box-shadow: 0 8px 24px rgba(0, 0, 0, .5)

            .navbar-item
                color: $dark-text

                &:hover
                    background-color: $dark-surface-2

        .navbar-link::after
            border-color: $dark-link

        .navbar-logo
            img
                filter: brightness(0) invert(1)
                border: 2px solid #ffffff
                border-radius: 50%
                padding: 3px

            .navbar-site-label
                color: $dark-text-strong

        .navbar-cat-burger
            &:hover,
            &.is-active
                color: $dark-link
                background-color: rgba(88, 166, 255, .1)

    +until($navbar-breakpoint)
        .navbar-main .navbar-menu
            background-color: $dark-surface

    .lang-toggle
        .lang-toggle-pill
            border-color: rgba(255, 255, 255, .3)

        .lang-toggle-option
            color: $dark-text-muted

            &.is-active
                background: $dark-text
                color: $dark-bg
                cursor: default
                pointer-events: none

            &:not(.is-active):hover
                background: rgba(255, 255, 255, .08)

    // --- Cards (記事一覧 / サイドバーウィジェット) ---
    .card
        background-color: $dark-surface
        border: 1px solid $dark-border
        color: $dark-text

        .card-content
            color: $dark-text

        .title,
        .subtitle
            color: $dark-text-strong

        .article-card-title a
            color: $dark-text-strong

        &:hover
            box-shadow: 0 6px 18px rgba(0, 0, 0, .5)

    // カバー画像が無いカテゴリプレースホルダなど
    .card-image
        background-color: $dark-surface-2

    // --- Article 本文 ---
    article.article
        .content
            h2
                background: $dark-surface-2
                border-left-color: $dark-link

            h3
                border-bottom-color: $dark-border

            p, li, td, th, h1, h2, h3, h4, blockquote, dd
                code
                    background: #2d333b
                    color: #ff7b9c

            blockquote:not(.pullquote)
                background: $dark-surface-2
                border-left-color: $dark-link
                color: $dark-text

            table
                color: $dark-text

                thead th
                    background: $dark-surface-2
                    color: $dark-text-strong

                tbody tr:nth-child(even)
                    background-color: $dark-surface

                td, th
                    border-color: $dark-border

            a:not(.article-more)
                text-decoration-color: rgba(88, 166, 255, .4)

    // --- リンクプレビューカード ---
    .link-preview
        background: $dark-surface
        border-color: $dark-border
        color: $dark-text

        &:hover
            border-color: rgba(88, 166, 255, .5)
            box-shadow: 0 6px 16px rgba(0, 0, 0, .5)

        .og-image
            background: $dark-surface-2

        .og-title
            color: $dark-link

        .og-description
            color: $dark-text-muted

    // --- サイドバー / ウィジェット ---
    .menu-list a
        color: $dark-text

        &:hover
            background-color: $dark-surface-2
            color: $dark-text-strong

    // --- Tags ---
    .tag:not(.is-primary):not(.is-link):not(.is-info):not(.is-success):not(.is-warning):not(.is-danger)
        background-color: $dark-surface-2
        color: $dark-text

    // --- Footer ---
    .footer
        background-color: $dark-surface
        color: $dark-text-muted

        a
            color: $dark-link

    // --- Pagination ---
    .pagination-previous,
    .pagination-next,
    .pagination-link
        background-color: $dark-surface
        border-color: $dark-border
        color: $dark-text

        &:hover
            border-color: $dark-link

    // --- 検索モーダル ---
    .searchbox,
    .modal-card-head,
    .modal-card-body,
    .modal-card-foot
        background-color: $dark-surface
        color: $dark-text

    .searchbox .searchbox-result-item
        color: $dark-text

        &:hover
            background-color: $dark-surface-2

    // --- 目次 (TOC) ---
    #toc
        background-color: $dark-surface

        .menu-list a
            color: $dark-text
            background-color: transparent

            &:hover
                background-color: $dark-surface-2
                color: $dark-link

            &.is-active
                background-color: $dark-surface-2
                color: $dark-link

    // --- 入力欄 ---
    .input,
    .textarea
        background-color: $dark-surface-2
        border-color: $dark-border
        color: $dark-text

        &::placeholder
            color: $dark-text-muted

    // --- カテゴリーパネル ---
    .navbar-cat-panel
        background-color: $dark-surface
        box-shadow: 0 8px 24px rgba(0, 0, 0, .5)

        .navbar-cat-panel-item
            color: $dark-text

            &:hover
                background-color: $dark-surface-2
                color: $dark-link

    // --- PC カテゴリーバー ---
    .category-bar
        background-color: $dark-surface
        border-bottom-color: $dark-border

        .category-bar-item
            color: $dark-text

            &:hover
                color: $dark-link

    // --- SP 目次バー ---
    .sp-toc-bar
        background-color: $dark-surface
        border-bottom-color: $dark-border

        .sp-toc-trigger
            color: $dark-text

            &:hover,
            &.is-toc-open
                color: $dark-link

    // --- 区切り線 ---
    hr
        background-color: $dark-border

    // --- 著者カード ---
    .author-card
        border-top-color: $dark-border

        .author-card-name
            color: $dark-text-strong

        .author-card-btn
            background-color: $dark-surface-2
            border-color: $dark-border
            color: $dark-text

            &:hover
                border-color: $dark-link
                color: $dark-link
