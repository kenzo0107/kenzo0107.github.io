/* ---------------------------------
 *    Category breadcrumb spacing
 * --------------------------------- */
.breadcrumb-card
    margin-bottom: 1.5rem

/* ---------------------------------
 *    Index article card grid
 * --------------------------------- */
.article-cards
    // Cards in the same row share equal height
    .column
        display: flex

    .article-card
        display: flex
        flex-direction: column
        width: 100%
        height: 100%
        margin-top: 0
        transition: transform .2s ease, box-shadow .2s ease

        &:hover
            transform: translateY(-4px)
            box-shadow: 0 8px 24px rgba(0, 0, 0, .12)

        .card-image-link
            display: block

        // Cover banners are generated at 2400x1000 (12:5). Match the box ratio
        // so they are shown in full instead of being side-cropped by a 16:9 box.
        .article-card-cover
            padding-top: 41.67%

            img, .has-ratio
                position: absolute
                top: 0
                left: 0
                height: 100%
                width: 100%

        .card-content
            flex: 1
            display: flex
            flex-direction: column
            padding: 1rem 1.25rem 1.25rem

        .article-card-meta
            display: flex
            flex-wrap: wrap
            align-items: center
            color: $text-light
            margin-bottom: .4rem

            .article-card-date
                margin-right: .6rem

            .article-card-category a
                color: $text-light

                &:hover
                    color: $primary

                & + a:before
                    content: '/'
                    margin: 0 .3em
                    color: $text-light

        .article-card-title
            font-size: 1.05rem
            font-weight: normal
            line-height: 1.4
            margin: 0
            display: -webkit-box
            -webkit-line-clamp: 3
            -webkit-box-orient: vertical
            overflow: hidden

        // Placeholder shown for posts without a cover image.
        // Shows only the category name (not the title) so it does not duplicate
        // the text title below. The span uses Bulma's .has-ratio to fill the box.
        .article-card-noimage .article-card-noimage-text
            display: flex
            align-items: center
            justify-content: center
            background: linear-gradient(135deg, $primary 0%, darken($primary, 18%) 100%)
            color: rgba(255, 255, 255, .95)
            font-size: 1.3rem
            font-weight: 700
            letter-spacing: .08em
            text-transform: uppercase
            line-height: 1.3
            padding: 1rem 1.25rem
            text-align: center
