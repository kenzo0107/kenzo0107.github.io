/* ---------------------------------
 *         Responsive Layout
 * --------------------------------- */

// widescreen 以上では 2 列コンテナを拡張して記事と目次に十分な幅を確保する
+widescreen()
    .is-1-column .container
        max-width: $desktop - 2 * $gap
        width: $desktop - 2 * $gap
    .is-2-column .container
        max-width: $widescreen - 2 * $gap
        width: $widescreen - 2 * $gap

// desktop-only (1024-1215px): 目次列を非表示にして記事幅を確保する
+desktop-only()
    .is-2-column .column-left
        display: none
    .is-2-column .column-main
        flex: none
        width: 100%

+fullhd()
    .is-2-column .container
        max-width: $widescreen - 2 * $gap
        width: $widescreen - 2 * $gap

    .is-1-column .container
        max-width: $desktop - 2 * $gap
        width: $desktop - 2 * $gap

+tablet()
    .is-sticky
        position: -webkit-sticky
        position: sticky
        top: 1.5rem
        z-index: 99

    .column-main, .column-left, .column-right, .column-right-shadow
        &.is-sticky
            top: .75rem
            align-self: flex-start

+mobile()
    .section
        padding: 1.5rem 1rem

    .page-post
        .section
            padding-left: 0
            padding-right: 0

        .columns
            margin-left: 0
            margin-right: 0

        .column-main
            padding-left: 0
            padding-right: 0

        .card
            border-radius: 0
