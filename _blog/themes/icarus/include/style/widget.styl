.widget
    .menu-list
        li
            ul
                margin-right: 0

        .level
            margin-bottom: 0

            .level-left, .level-right, .level-item
                flex-shrink: 1

            .level-left, .level-right
                align-items: flex-start

        .tag
            background: $light-grey
            color: $white-invert

    .tags
        .tag:first-child
            background: $primary
            color: $primary-invert

        .tag:last-child
            background: $light-grey
            color: $white-invert

.level.is-multiline
    flex-wrap: wrap

/* ---------------------------------
 *      Table of Content Widget
 * --------------------------------- */
+mobile()
    .widget.card#toc
        display: none
        position: fixed
        top: calc(var(--navbar-h, 3.25rem) + 0.5rem)
        right: 0.5rem
        left: auto
        bottom: auto
        width: 78vw
        max-width: 22rem
        max-height: 55vh
        margin: 0
        z-index: 100
        overflow: hidden

        .card-content
            padding: 0

        .menu
            padding: 1rem
            max-height: calc(55vh - 2.5rem)
            overflow-y: auto
            font-size: 0.85rem

    #toc-mask
        display: none
        position: fixed
        top: 0
        left: 0
        right: 0
        bottom: 0
        z-index: 99
        background: rgba(0, 0, 0, .7)

    .widget.card#toc, #toc-mask
        &.is-active
            display: block