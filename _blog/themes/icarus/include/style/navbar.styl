/* ---------------------------------
 *           Top Navigation
 * --------------------------------- */
$navbar-item-padding-v ?= 1.25rem
$navbar-item-padding-h ?= .75rem
$navbar-item-margin-v ?= 0
$navbar-item-margin-h ?= 0

.navbar-main
    box-shadow: $shadow

    .navbar-item
        display: flex
        align-items: center
        padding: $navbar-item-padding-v $navbar-item-padding-h
        margin: $navbar-item-margin-v $navbar-item-margin-h

        &.is-active
            background-color: transparent

    // --- デスクトップ (PC幅): メニューを横並びでヘッダーに表示 ---
    +from($navbar-breakpoint)
        .navbar-menu
            align-items: stretch
            display: flex
            flex-grow: 1
            padding: 0

        .navbar-start
            align-items: stretch
            display: flex
            justify-content: flex-start
            margin-right: auto

        .navbar-end
            align-items: stretch
            display: flex
            justify-content: flex-end
            margin-left: auto

    // --- スマホ / タブレット幅: ハンバーガーメニューで開閉 ---
    +until($navbar-breakpoint)
        .navbar-menu
            box-shadow: 0 8px 16px rgba(10, 10, 10, .1)

            .navbar-item
                padding: .75rem 1rem

// Categories ドロップダウン
.navbar-categories
    .navbar-dropdown
        .navbar-item
            display: flex
            justify-content: space-between
            align-items: center

        .navbar-category-count
            margin-left: 1.5em
            min-width: 1.6em
            padding: .05em .5em
            border-radius: 10px
            background: $primary
            color: #fff
            font-size: .72rem
            font-weight: 600
            text-align: center

// 言語ピルトグル
.lang-toggle
    padding-left: .5rem
    padding-right: .5rem

    .lang-toggle-pill
        display: inline-flex
        border-radius: 1em
        border: 1.5px solid $primary
        overflow: hidden
        font-size: .72rem
        font-weight: 700
        letter-spacing: .04em

    .lang-toggle-option
        padding: .28em .75em
        color: $primary
        transition: background .18s, color .18s
        white-space: nowrap
        line-height: 1.4

        &.is-active
            background: $primary
            color: #fff

        &:not(.is-active):hover
            background: rgba($primary, .08)

// ダーク / ライト トグル
.theme-toggle
    cursor: pointer

    .theme-toggle-light
        display: none

html[data-theme='dark']
    .theme-toggle
        .theme-toggle-dark
            display: none

        .theme-toggle-light
            display: inline-block

.navbar-logo
    img
        max-height: $logo-height

@media screen and (min-width: $desktop)
    .navbar > .container .navbar-menu, .container > .navbar .navbar-menu
        margin-right: 0rem
