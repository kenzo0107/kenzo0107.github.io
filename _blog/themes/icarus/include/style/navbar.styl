/* ---------------------------------
 *           Top Navigation
 * --------------------------------- */
$navbar-item-padding-v ?= 1.25rem
$navbar-item-padding-h ?= .75rem
$navbar-item-margin-v ?= 0
$navbar-item-margin-h ?= 0

.navbar-main
    box-shadow: $shadow
    position: sticky
    top: 0
    z-index: 30

    .navbar-item
        display: flex
        align-items: center
        padding: $navbar-item-padding-v $navbar-item-padding-h
        margin: $navbar-item-margin-v $navbar-item-margin-h

        &.is-active
            background-color: transparent

    // --- デスクトップ (PC幅): メニューを横並びでヘッダーに表示 ---
    +from($navbar-breakpoint)
        .navbar-menu
            align-items: stretch
            display: flex
            flex-grow: 1
            padding: 0

        .navbar-start
            align-items: stretch
            display: flex
            justify-content: flex-start
            margin-right: auto

        .navbar-end
            align-items: stretch
            display: flex
            justify-content: flex-end
            margin-left: auto

    // --- スマホ / タブレット幅 ---
    +until($navbar-breakpoint)
        .navbar-brand
            align-items: center

        .navbar-menu
            display: none  // ハンバーガーで開くメニューは不要（カテゴリーは cat-panel で）

// ナビバーコンテナ: cat-panel の絶対位置基準
.navbar-container
    position: relative

// navbar-brand: ロゴと右側アイコン群のレイアウト
.navbar-brand-right
    display: flex
    align-items: center
    margin-left: auto  // SP で右寄せ

// ---------------------------------
// カテゴリーハンバーガーボタン（SP のみ、ロゴ左）
// ---------------------------------
.navbar-cat-burger
    display: flex
    +from($navbar-breakpoint)
        display: none !important
    flex-direction: column
    align-items: center
    justify-content: center
    cursor: pointer
    padding: 0 .85rem
    height: $navbar-height
    color: $text
    text-decoration: none
    transition: color .18s, background-color .18s
    border-radius: 4px

    span
        display: block
        width: 20px
        height: 0
        border-top: 2px solid currentColor
        margin: 5px 0
        border-radius: 2px
        transition: border-color .18s

    &:hover,
    &.is-active
        color: $primary
        background-color: rgba($primary, .08)

// ---------------------------------
// カテゴリーパネル（絶対位置・左寄せ・固定幅でオーバーレイ）
// ---------------------------------
.navbar-cat-panel
    display: none
    position: absolute
    top: 100%
    left: 0
    min-width: 240px
    max-width: 320px
    background-color: $scheme-main
    box-shadow: 0 8px 24px rgba(10, 10, 10, .12), 0 0 0 1px rgba(10, 10, 10, .05)
    border-radius: 0 0 6px 0
    z-index: 35
    padding: .5rem 0
    overflow-y: auto
    max-height: "calc(100vh - %s)" % $navbar-height

    &.is-active
        display: block

.navbar-cat-panel-item
    display: flex
    justify-content: space-between
    align-items: center
    padding: .55rem 1.25rem
    color: $text
    text-decoration: none
    white-space: nowrap
    font-size: .9rem
    transition: background-color .15s, color .15s

    &:hover
        background-color: $background
        color: $primary

.navbar-category-count
    margin-left: 1.5em
    min-width: 1.6em
    padding: .05em .5em
    border-radius: 10px
    background: $primary
    color: #fff
    font-size: .72rem
    font-weight: 600
    text-align: center

// ---------------------------------
// 言語ピルトグル
// ---------------------------------
.lang-toggle
    padding-left: .5rem
    padding-right: .5rem

    .lang-toggle-pill
        display: inline-flex
        border-radius: 1em
        border: 1.5px solid $border
        overflow: hidden
        font-size: .72rem
        font-weight: 700
        letter-spacing: .04em

    .lang-toggle-option
        padding: .28em .75em
        color: $text
        text-decoration: none
        transition: background .18s, color .18s
        white-space: nowrap
        line-height: 1.4
        cursor: pointer

        &.is-active
            background: $text
            color: #fff
            cursor: default
            pointer-events: none

        &:not(.is-active):hover
            background: rgba($text, .08)

// ---------------------------------
// ダーク / ライト トグル
// ---------------------------------
.theme-toggle
    cursor: pointer

    .theme-toggle-light
        display: none

html[data-theme='dark']
    .theme-toggle
        .theme-toggle-dark
            display: none

        .theme-toggle-light
            display: inline-block

.navbar-logo
    text-decoration: none
    align-items: center
    gap: .5rem

    img
        max-height: $logo-height

    &:hover
        text-decoration: none

    .navbar-site-label
        font-size: 1rem
        font-weight: 700
        letter-spacing: .04em
        color: $text
        text-decoration: none
        white-space: nowrap

@media screen and (min-width: $desktop)
    .navbar > .container .navbar-menu, .container > .navbar .navbar-menu
        margin-right: 0rem

// ---------------------------------
// PC版カテゴリーバー（ナビバー直下・デスクトップのみ表示）
// ---------------------------------
.category-bar
    border-bottom: 1px solid $border
    background-color: $scheme-main
    +from($navbar-breakpoint)
        position: sticky
        top: var(--navbar-h, $navbar-height)
        z-index: 29

.category-bar-inner
    display: flex
    flex-wrap: wrap
    align-items: center
    padding: 0 .5rem

.category-bar-item
    padding: .45rem .75rem
    font-size: .875rem
    color: $text
    text-decoration: none
    white-space: nowrap
    transition: color .18s

    &:hover
        color: $primary

// 記事詳細ページ: カテゴリーバーのスティッキーを解除
body.page-post
    +from($navbar-breakpoint)
        .category-bar
            position: static

// ---------------------------------
// SP専用目次バー（スクロール時にナビバー直下に固定）
// ---------------------------------
.sp-toc-bar
    background-color: $scheme-main
    border-bottom: 1px solid $border
    position: sticky
    top: var(--navbar-h, $navbar-height)
    z-index: 28

.sp-toc-trigger
    display: inline-flex
    align-items: center
    gap: .4rem
    padding: .7rem .75rem
    font-size: .85rem
    color: $text
    text-decoration: none
    cursor: pointer
    transition: color .18s

    i
        font-size: .8rem

    &:hover,
    &.is-toc-open
        color: $primary

// 記事詳細ページ: ナビバーのスティッキーを解除（PC・SP共通）
body.page-post
    .navbar-main
        position: static
    .sp-toc-bar
        position: sticky  // 記事ページでは目次バーはスティッキーを維持
        top: 0            // ナビバーが静的なのでスクロール後は画面最上部に固定
