/* ---------------------------------
 *           Top Navigation
 * --------------------------------- */
$navbar-item-padding-v ?= 1.25rem
$navbar-item-padding-h ?= .75rem
$navbar-item-margin-v ?= 0
$navbar-item-margin-h ?= 0

.navbar-main
    box-shadow: $shadow

    .navbar-item
        display: flex
        align-items: center
        padding: $navbar-item-padding-v $navbar-item-padding-h
        margin: $navbar-item-margin-v $navbar-item-margin-h

        &.is-active
            background-color: transparent

    // --- デスクトップ (PC幅): メニューを横並びでヘッダーに表示 ---
    +from($navbar-breakpoint)
        .navbar-menu
            align-items: stretch
            display: flex
            flex-grow: 1
            padding: 0

        .navbar-start
            align-items: stretch
            display: flex
            justify-content: flex-start
            margin-right: auto

        .navbar-end
            align-items: stretch
            display: flex
            justify-content: flex-end
            margin-left: auto

    // --- スマホ / タブレット幅: ハンバーガーメニューで開閉 ---
    +until($navbar-breakpoint)
        // ロゴ左固定・他アイテム右寄せ・縦位置揃え
        .navbar-brand
            align-items: center

        .navbar-brand .navbar-logo
            margin-right: auto

        .navbar-menu
            box-shadow: 0 8px 16px rgba(10, 10, 10, .1)
            background-color: #fff

            .navbar-item
                padding: .4rem .75rem

            .navbar-item.has-dropdown
                padding: 0

            // ハンバーガー内はカテゴリーのみ表示
            .navbar-start
                .navbar-item:not(.navbar-categories)
                    display: none

            .navbar-end
                display: none

            // ハンバーガー開放時: コンテンツに被さるオーバーレイ表示
            &.is-active
                position: absolute
                top: 100%
                left: 0
                right: 0
                z-index: 30
                max-height: "calc(100vh - %s)" % $navbar-height
                overflow-y: auto

// Categories: モバイルのみドロップダウン表示
.navbar-categories
    +until($navbar-breakpoint)
        .navbar-dropdown
            display: block
            position: static
            box-shadow: none
            padding: 0
            border-top: none
            .navbar-item
                display: flex !important

        .navbar-dropdown
            .navbar-item
                display: flex
                justify-content: space-between
                align-items: center

            .navbar-category-count
                margin-left: 1.5em
                min-width: 1.6em
                padding: .05em .5em
                border-radius: 10px
                background: $primary
                color: #fff
                font-size: .72rem
                font-weight: 600
                text-align: center

// 言語ピルトグル
.lang-toggle
    padding-left: .5rem
    padding-right: .5rem

    .lang-toggle-pill
        display: inline-flex
        border-radius: 1em
        border: 1.5px solid $primary
        overflow: hidden
        font-size: .72rem
        font-weight: 700
        letter-spacing: .04em

    .lang-toggle-option
        padding: .28em .75em
        color: #aaa
        text-decoration: none
        transition: background .18s, color .18s
        white-space: nowrap
        line-height: 1.4
        cursor: pointer

        &.is-active
            background: $primary
            color: #fff
            cursor: default
            pointer-events: none

        &:not(.is-active):hover
            background: rgba($primary, .08)
            color: $primary

// ダーク / ライト トグル
.theme-toggle
    cursor: pointer

    .theme-toggle-light
        display: none

html[data-theme='dark']
    .theme-toggle
        .theme-toggle-dark
            display: none

        .theme-toggle-light
            display: inline-block

.navbar-logo
    img
        max-height: $logo-height

@media screen and (min-width: $desktop)
    .navbar > .container .navbar-menu, .container > .navbar .navbar-menu
        margin-right: 0rem

// カテゴリーバー（PC 専用、ナビバー直下の横並びリンク）
.category-bar
    border-bottom: 1px solid $border

    .category-bar-inner
        display: flex
        flex-wrap: wrap
        align-items: center
        padding: 0 .5rem

    .category-bar-item
        padding: .45rem .75rem
        font-size: .875rem
        color: $text
        text-decoration: none
        white-space: nowrap
        transition: color .18s

        &:hover
            color: $primary
