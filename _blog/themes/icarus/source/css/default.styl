/* ---------------------------------
 *   Variable overrides
 *   (must be defined before import)
 * --------------------------------- */
$body-size = 16px
$family-sans-serif = 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', 'Yu Gothic', Meiryo, sans-serif
$family-code = 'JetBrains Mono', 'Source Code Pro', Menlo, Consolas, monospace
$title-weight = 600
$content-heading-weight = 700
$article-font-size = 1.05rem

@import 'style'

/* ---------------------------------
 *   Dark mode + navbar(categories/hamburger/theme toggle/lang switcher)
 *   は style.styl 経由で取り込まれる（このコメントは再生成トリガー用 r7）
 * --------------------------------- */

/* ---------------------------------
 *   Readability customizations
 *   (index card grid imported via 'style'; 12:5 cover ratio; category placeholder)
 * --------------------------------- */

// Tech-blog accent line on top of the navbar
.navbar-main
    &::before
        content: ''
        position: absolute
        top: 0
        left: 0
        right: 0
        height: 3px
        background: linear-gradient(90deg, #3273dc 0%, #00d1b2 100%)
        z-index: 1

article.article
    .content
        line-height: 1.9
        letter-spacing: .02em

        p
            margin-bottom: 1.2em

        h2
            margin-top: 2.5em
            padding: .5em .6em
            background: #f4f6f8
            border-left: 5px solid $primary
            border-radius: 3px
            line-height: 1.4

        h3
            margin-top: 2em
            padding-bottom: .3em
            border-bottom: 2px solid #e4e9ee
            line-height: 1.4

        h4
            margin-top: 1.8em

        // Restore inline-code highlighting (excludes code inside pre)
        p, li, td, th, h1, h2, h3, h4, blockquote, dd
            code
                padding: .15em .45em
                background: #f1f3f5
                color: #d6336c
                border-radius: 4px
                font-size: .875em

        blockquote:not(.pullquote)
            border-left: 4px solid $primary
            background: #f6f9fd
            color: $grey-dark

        table
            font-size: .95em

            thead th
                background: #f4f6f8
                white-space: nowrap

            tbody tr:nth-child(even)
                background-color: #fafbfc

        a:not(.article-more)
            text-decoration: underline
            text-underline-offset: 3px
            text-decoration-color: rgba(50, 115, 220, .35)

            &:hover
                text-decoration-color: currentColor

        img
            border-radius: 6px

// 目次リンクをクリックしたら見出しまでスムーズにスクロールする
html
    scroll-behavior: smooth

article.article
    .content
        h1, h2, h3, h4, h5, h6
            scroll-margin-top: 1.2rem

// Code blocks: dark console-style design
figure.highlight
    background: #0d1117
    border: 1px solid #30363d
    border-radius: 8px
    overflow: hidden
    box-shadow: 0 8px 24px rgba(0, 0, 0, .35)
    font-family: $family-code

    // ターミナル風ヘッダーバー（左に信号機ドット）
    figcaption
        background: #161b22
        border-bottom: 1px solid #30363d
        padding-left: 4.4em
        position: relative
        color: #8b949e

        &::before
            content: ''
            position: absolute
            top: 50%
            left: 1.1em
            transform: translateY(-50%)
            width: .72em
            height: .72em
            border-radius: 50%
            background: #ff5f56
            box-shadow: 1.25em 0 0 #ffbd2e, 2.5em 0 0 #27c93f

        span
            color: #c9d1d9

        a, i, .fold
            color: #8b949e

            &:hover
                color: #c9d1d9

    // 行番号のガター
    .gutter
        background: #161b22
        color: #6e7681
        border-right: 1px solid #21262d

    // コピーボタン
    .copy
        color: #8b949e

        &:hover
            color: #c9d1d9

// Card hover feedback on index pages
.card
    transition: box-shadow .2s ease

    &:hover
        box-shadow: 0 6px 16px rgba(0, 0, 0, .08), 0 0 1px rgba(0, 0, 0, .1)

// Link preview cards ({% linkPreview %} tag)
.link-preview
    display: block
    margin: 1.5em 0
    border: 1px solid #e4e9ee
    border-radius: 8px
    overflow: hidden
    background: #fff
    color: $grey-dark
    text-decoration: none
    transition: box-shadow .2s ease, border-color .2s ease

    &:hover
        border-color: rgba(50, 115, 220, .4)
        box-shadow: 0 6px 16px rgba(0, 0, 0, .08)

    .link-area
        display: flex
        align-items: stretch

    .og-image
        flex: 0 0 30%
        max-width: 200px
        overflow: hidden
        background: #f4f6f8

        img
            display: block
            width: 100%
            height: 100%
            object-fit: cover
            border-radius: 0

    .descriptions
        flex: 1 1 auto
        min-width: 0
        padding: .9em 1.1em
        display: flex
        flex-direction: column
        justify-content: center

    .og-title
        font-weight: 600
        line-height: 1.4
        color: $primary
        // 2行で省略
        display: -webkit-box
        -webkit-line-clamp: 2
        -webkit-box-orient: vertical
        overflow: hidden

    .og-description
        margin-top: .4em
        font-size: .85em
        color: $grey
        line-height: 1.5
        display: -webkit-box
        -webkit-line-clamp: 2
        -webkit-box-orient: vertical
        overflow: hidden

@media screen and (max-width: 768px)
    .link-preview
        .link-area
            flex-direction: column

        .og-image
            flex-basis: auto
            max-width: 100%
            max-height: 180px

// ── 言語ピルトグル（navbar 右端） ──────────────────────────────
.lang-toggle
    padding-left: .5rem
    padding-right: .5rem

    .lang-toggle-pill
        display: inline-flex
        border-radius: 1em
        border: 1.5px solid $primary
        overflow: hidden
        font-size: .72rem
        font-weight: 700
        letter-spacing: .04em

    .lang-toggle-option
        padding: .28em .75em
        color: $primary
        transition: background .18s, color .18s
        white-space: nowrap
        line-height: 1.4

        &.is-active
            background: $primary
            color: #fff

        &:not(.is-active):hover
            background: rgba($primary, .08)

html[data-theme='dark']
    .lang-toggle
        .lang-toggle-pill
            border-color: #58a6ff

        .lang-toggle-option
            color: #58a6ff

            &.is-active
                background: #58a6ff
                color: #14181d

            &:not(.is-active):hover
                background: rgba(88, 166, 255, .12)

// ── SP用フローティング目次ボタン ──────────────────────────────
#sp-toc-btn
    display: none

+mobile()
    #sp-toc-btn
        display: flex
        position: fixed
        top: calc(var(--navbar-h, 3.25rem) + 0.75rem)
        right: 0.75rem
        z-index: 101
        width: 2.75rem
        height: 2.75rem
        border-radius: 50%
        background: $primary
        color: #fff
        align-items: center
        justify-content: center
        box-shadow: 0 2px 10px rgba(0, 0, 0, .3)
        text-decoration: none
        font-size: 1.05rem
        transition: transform .15s, box-shadow .15s, background .15s

        &:hover
            transform: scale(1.06)
            box-shadow: 0 4px 14px rgba(0, 0, 0, .35)

        &.is-toc-open
            background: darken($primary, 10%)

html[data-theme='dark']
    +mobile()
        #sp-toc-btn
            background: #58a6ff
            color: #14181d

            &.is-toc-open
                background: #3b8fe8
